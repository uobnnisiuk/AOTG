+    def record_memory_context(self, owned, native_pid, observed):
+        """Diagnostic reads follow the passed guard and flushed primary sample.
+
+        Rejected guards never call this method, so cleanup has no added reads.
+        Missing context does not become a successful guard or a zero counter.
+        """
+        try:
+            def bound(pid):
+                info = owned.records[pid]
+                return {"pid": info["pid"], "start_ticks": info["start_ticks"]}
+            root = bound(owned.process.pid) if owned is not None else None
+            native = bound(native_pid) if native_pid is not None and owned is not None else None
+            context = collect_resource_context("/system.slice/" + self.plan["maintenance_unit"],
+                                               root_identity=root, native_identity=native)
+        except Exception as error:
+            context = {"artifact": "aotg-memory-context", "version": 1,
+                       "status": "incomplete", "diagnostic_only": True,
+                       "reason": type(error).__name__, "guard_accepted": None,
+                       "cause_attribution_proven": False}
+        self.record_observation({**observed, "phase": "memory-context-after-pass",
+                                 "guard_verdict": "not-evaluated", "context": context})
