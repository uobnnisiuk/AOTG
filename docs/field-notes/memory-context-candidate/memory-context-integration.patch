+        if self.rows + len(encoded) > self.limits.max_rows:
+            self._stop('aggregate-row-cap')
+        if self.bytes + size > self.limits.max_bytes:
+            self._stop('aggregate-byte-cap')
+        self.rows += len(encoded)
