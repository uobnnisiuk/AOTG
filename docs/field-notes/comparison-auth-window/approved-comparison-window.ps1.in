param(
 [string]$ApprovalPath='',
 [string]$ApprovalSha256='',
 [switch]$ExecuteApprovedWindow
)
$ErrorActionPreference='Stop'
# This child process only: avoid incompatible inherited PS7 module paths.
$env:PSModulePath=[IO.Path]::Combine($PSHOME,'Modules')
$Pinned = ConvertFrom-Json @'
__PINNED_JSON__
'@
function Assert-PinnedFile([string]$Path,[string]$Sha) {
 if($Sha -cnotmatch '^[0-9a-f]{64}$'){throw 'Invalid frozen file fingerprint'}
 $item=[IO.FileInfo]::new($Path)
 if(!$item.Exists -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)){throw 'Unsafe pinned file'}
 $stream=[IO.File]::Open($Path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
 $hasher=[Security.Cryptography.SHA256]::Create()
 try{$actual=[BitConverter]::ToString($hasher.ComputeHash($stream)).Replace('-','').ToLowerInvariant()}
 finally{$hasher.Dispose();$stream.Dispose()}
 if($actual -cne $Sha){throw 'Frozen input changed; authentication and start refused'}
}
function Assert-AllPins {
 foreach($item in $Pinned.files){Assert-PinnedFile $item.path $item.sha256}
 if($ApprovalPath -or $ApprovalSha256){
  if(!$ApprovalPath -or !$ApprovalSha256){throw 'Approval path and exact raw hash are both required'}
  Assert-PinnedFile $ApprovalPath $ApprovalSha256
 }
}
function Approval-WslPath {
 if($ApprovalPath -cmatch '^C:\\'){
  $value='/mnt/c/'+$ApprovalPath.Substring(3).Replace([char]92,[char]47)
 }elseif($ApprovalPath.StartsWith('\\wsl.localhost\Ubuntu\',[StringComparison]::Ordinal)){
  $value='/'+$ApprovalPath.Substring('\\wsl.localhost\Ubuntu\'.Length).Replace([char]92,[char]47)
 }else{throw 'Approval must have an explicit supported local path'}
 if($value -cnotmatch '^/[A-Za-z0-9_./-]+$' -or $value -match '//|/(\.|\.\.)(/|$)'){
  throw 'Approval path must use canonical safe literal argument characters'
 }
 return $value
}
function Invoke-LocalLauncher([bool]$Launch) {
 $nativeArgs=@('-d','Ubuntu','--',$Pinned.python,'-I','-S','-B',$Pinned.launcher,'--plan',$Pinned.launch_plan)
 if($ApprovalPath){$nativeArgs+=@('--approval',(Approval-WslPath),'--approval-sha256',$ApprovalSha256)}
 if($Launch){
  $nativeArgs+=@('--execute-approved-launch-plan-sha256',$Pinned.launch_plan_canonical_sha256,
                '--execute-approved-release-plan-sha256',$Pinned.release_plan_canonical_sha256)
 }
 $lines=@(& $Pinned.wsl @nativeArgs)
 $code=$LASTEXITCODE
 if($code -ne 0){throw ('Local validation/launch failed; do not retry automatically. Exit '+$code)}
 if($lines.Count -ne 1){throw 'Unexpected local launcher response; do not retry automatically'}
 $value=$lines[0] | ConvertFrom-Json
 if($Launch){
  if($value.status -cne 'detached-supervisor-started' -or $value.retry_permitted -ne $false){throw 'Launch result unverified; do not retry'}
 }else{
  if($value.execute -ne $false -or $value.process_started -ne $false -or
     $value.remote_actions_executed -ne $false -or
     $value.launch_plan_sha256 -cne $Pinned.launch_plan_canonical_sha256 -or
     $value.release_plan_sha256 -cne $Pinned.release_plan_canonical_sha256){throw 'Preview result invalid'}
  if($ExecuteApprovedWindow -and $value.status -cne 'APPROVAL-VERIFIED-NO-EXECUTION'){throw 'Separate explicit scope approval required'}
 }
 return $value
}
# ENTRY: no SSH or authentication can precede the complete local preview.
Assert-AllPins
$preview=Invoke-LocalLauncher $false
if(!$ExecuteApprovedWindow){$preview | ConvertTo-Json -Compress;exit 0}
if(!$ApprovalPath -or !$ApprovalSha256){throw 'New scope approval receipt required before authentication'}
$Host.UI.RawUI.WindowTitle='AOTG approved comparison - automatic restoration'
Write-Host 'APPROVED 64-TRIAL COMPARISON: one authentication starts the comparison and restoration.'
Write-Host 'Production inference is temporarily unavailable during the approved operation.'
Write-Host 'Work cap: 90 minutes. Recovery cap: 10 minutes. Monitoring/collection have separate finite limits.'
Write-Host 'After authentication, no further chat reply or confirmation is needed.'
Write-Host 'Do not send the password in chat. This script does not save it.'
$null=Read-Host 'When ready, press Enter to authenticate and automatically start the approved comparison'
Assert-AllPins
$preview=Invoke-LocalLauncher $false
$sshArgs=@($Pinned.ssh_args)
& $Pinned.ssh @sshArgs $Pinned.command
$authExit=$LASTEXITCODE
if($authExit -ne 0){
 Write-Host 'Authentication did not confirm readiness. No automatic retry or comparison launch was made.'
 exit $authExit
}
# Successful authentication starts the detached chain in this same invocation.
Assert-AllPins
$launch=Invoke-LocalLauncher $true
Write-Host ('Detached supervisor started, PID '+$launch.pid+'. This window may close.')
Write-Host 'Completion and restoration are not yet independently verified; durable records track the outcome.'
exit 0
